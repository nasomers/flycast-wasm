 {
+#if defined(__EMSCRIPTEN__) && !defined(JIT_PROD_BUILD)
+	g_fly_asic_total++;
+	g_fly_asic_by_id[(((u32)inter >> 8) << 5) | ((u32)inter & 31)]++;
