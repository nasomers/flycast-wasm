+	else if ((u32)inter == 0x0007) g_fly_ack[3]++;  // opaque-EOL raise
+	switch ((u32)inter) {
+	case 0x0003: g_fly_asic_vblank_in++;  break;
+	case 0x0004: g_fly_asic_vblank_out++; break;
+	case 0x0005: g_fly_asic_hblank++;     break;
+	case 0x0012: g_fly_asic_maple++;      break;
+	}
+#endif
 	u8 type = inter >> 8;
 	u32 mask = 1 << (u8)inter;
 	switch(type)
